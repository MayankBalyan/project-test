# Copy to .env and fill in. Get both values from your Supabase project's "Connect" dialog
# (or from `npx supabase status` when running Supabase locally).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Set to true once Google is enabled under Auth > Providers in Supabase.
EXPO_PUBLIC_AUTH_GOOGLE=false
